      "$$hashKey": "object:2288",
      "text": "\r\nval categoricalCols = dfWeather.schema.fields.collect {\r\n  case StructField(name, StringType, _, _) => name\r\n}\r\n\r\ncategoricalCols.foreach { c =>\r\n  println(s\"Valores únicos en '$c':\")\r\n  dfWeather.groupBy(col(c)).count().orderBy(desc(\"count\")).show(20, false)\r\n}\r\n",
      "dateUpdated": "2025-07-10T01:29:29+0000",
      "dateFinished": "2025-07-10T01:29:30+0000",
      "dateStarted": "2025-07-10T01:29:29+0000",
      "results": {
        "code": "SUCCESS",
        "msg": [
